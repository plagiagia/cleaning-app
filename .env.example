# Neon Postgres (Vercel Marketplace: Storage → Neon)
# After linking Neon in Vercel, pull env vars locally:
#   vercel env pull .env.local --yes
#
# Use the pooled connection string for DATABASE_URL.
# Vercel Neon integration may expose this as POSTGRES_PRISMA_URL — copy that value here.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Email (choose SMTP or Resend; SMTP is recommended for Yahoo) ---

# Option A: Yahoo / SMTP (recommended — works with s.cleaning2025@yahoo.com)
# Generate an app password at https://login.yahoo.com/account/security
SMTP_HOST="smtp.mail.yahoo.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="s.cleaning2025@yahoo.com"
SMTP_PASS="your-yahoo-app-password"
SMTP_FROM="S.cleaning <s.cleaning2025@yahoo.com>"
COMPANY_EMAIL="s.cleaning2025@yahoo.com"

# Option B: Resend (https://resend.com)
# Note: onboarding@resend.dev only sends to YOUR Resend account email.
# For production you must verify your own domain at resend.com/domains.
# RESEND_API_KEY="re_xxxxxxxx"
# FROM_EMAIL="S.cleaning <bookings@yourdomain.com>"
# COMPANY_EMAIL="s.cleaning2025@yahoo.com"
