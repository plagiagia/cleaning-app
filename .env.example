# Neon Postgres (Vercel Marketplace: Storage → Neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Email (pick one option) ---

# Option A: Formspree — EASIEST on Vercel (recommended)
# Web3Forms blocks *.vercel.app domains; Formspree works out of the box.
# 1. Go to https://formspree.io and sign up (free)
# 2. Create a new form → enter s.cleaning2025@yahoo.com as recipient
# 3. Copy the form ID from the endpoint URL: https://formspree.io/f/YOUR_FORM_ID
# 4. Add YOUR_FORM_ID below and in Vercel env vars, then redeploy
FORMSPREE_FORM_ID="your-form-id-here"

# Option B: Yahoo SMTP (also sends customer confirmation emails)
# SMTP_HOST="smtp.mail.yahoo.com"
# SMTP_PORT="465"
# SMTP_SECURE="true"
# SMTP_USER="s.cleaning2025@yahoo.com"
# SMTP_PASS="your-yahoo-app-password"
# SMTP_FROM="S.cleaning <s.cleaning2025@yahoo.com>"
# COMPANY_EMAIL="s.cleaning2025@yahoo.com"

# Option C: Resend (requires verified domain for production)
# RESEND_API_KEY="re_xxxxxxxx"
# FROM_EMAIL="S.cleaning <bookings@yourdomain.com>"
# COMPANY_EMAIL="s.cleaning2025@yahoo.com"
